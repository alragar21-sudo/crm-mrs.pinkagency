# Base de datos Neon (obligatorio)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Identificador de la agencia (tenant). Por defecto "mrs-pink".
ACCOUNT_ID="mrs-pink"

# Email (Resend) — para que las campañas de email salgan de verdad.
RESEND_API_KEY=""
EMAIL_FROM="Mrs. Pink <hola@send.mrspinkagency.com>"

# Webhook de captación de leads (formularios/landings externas).
WEBHOOK_SECRET=""

# --- Fase 2 (opcionales, scaffold) ---
# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Meta Ads
META_APP_ID=""
META_APP_SECRET=""
